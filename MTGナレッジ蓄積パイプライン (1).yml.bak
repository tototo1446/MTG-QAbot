app:
  description: Loom/Zoomの文字起こしデータからQA形式のナレッジに変換し、タグ付けしてSupabaseに蓄積するワークフロー
  icon: 📚
  icon_background: '#FFEAD5'
  icon_type: emoji
  mode: workflow
  name: MTGナレッジ蓄積パイプライン
  use_icon_as_answer_icon: false
dependencies:
- current_identifier: null
  type: marketplace
  value:
    marketplace_plugin_unique_identifier: langgenius/openai:0.3.2@d70fb969e7c79719bee96573a8f4c9dc4ffd984f4171b9184cc3869c886af45d
    version: null
kind: app
version: 0.6.0
workflow:
  conversation_variables: []
  environment_variables:
  - description: Supabase プロジェクトURL
    id: env-supabase-url
    name: SUPABASE_URL
    selector:
    - env
    - SUPABASE_URL
    value: https://sxiukiihqyvjynxxgyhk.supabase.co
    value_type: string
  - description: Supabase サービスロールキー
    id: env-supabase-key
    name: SUPABASE_KEY
    selector:
    - env
    - SUPABASE_KEY
    value: ''
    value_type: secret
  - description: OpenAI APIキー（Embedding用）
    id: env-openai-key
    name: OPENAI_API_KEY
    selector:
    - env
    - OPENAI_API_KEY
    value: ''
    value_type: secret
  features:
    file_upload:
      allowed_file_extensions:
      - .JPG
      - .JPEG
      - .PNG
      - .GIF
      - .WEBP
      - .SVG
      allowed_file_types:
      - image
      allowed_file_upload_methods:
      - local_file
      - remote_url
      enabled: true
      fileUploadConfig:
        attachment_image_file_size_limit: 2
        audio_file_size_limit: 50
        batch_count_limit: 5
        file_size_limit: 15
        file_upload_limit: 50
        image_file_batch_limit: 10
        image_file_size_limit: 10
        single_chunk_attachment_limit: 10
        video_file_size_limit: 100
        workflow_file_upload_limit: 10
      image:
        enabled: false
        number_limits: 3
        transfer_methods:
        - local_file
        - remote_url
      number_limits: 3
    opening_statement: ''
    retriever_resource:
      enabled: false
    sensitive_word_avoidance:
      enabled: false
    speech_to_text:
      enabled: false
    suggested_questions: []
    suggested_questions_after_answer:
      enabled: false
    text_to_speech:
      enabled: false
      language: ''
      voice: ''
  graph:
    edges:
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: start
        targetType: code
      id: edge_0
      source: start_1
      sourceHandle: source
      target: code_classify
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: code
        targetType: document-extractor
      id: edge_0b
      source: code_classify
      sourceHandle: source
      target: doc_extractor
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: document-extractor
        targetType: code
      id: edge_1
      source: doc_extractor
      sourceHandle: source
      target: code_parse
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: code
        targetType: llm
      id: edge_2
      source: code_parse
      sourceHandle: source
      target: llm_chunk
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: llm
        targetType: code
      id: edge_3
      source: llm_chunk
      sourceHandle: source
      target: code_chunks
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: code
        targetType: iteration
      id: edge_4
      source: code_chunks
      sourceHandle: source
      target: iteration_1
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        sourceType: iteration-start
        targetType: llm
      id: edge_iter_1
      source: iteration_1_start
      sourceHandle: source
      target: llm_qa
      targetHandle: target
      type: custom
      zIndex: 1002
    - data:
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        sourceType: llm
        targetType: code
      id: edge_iter_2
      source: llm_qa
      sourceHandle: source
      target: code_build
      targetHandle: target
      type: custom
      zIndex: 1002
    - data:
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        sourceType: code
        targetType: code
      id: edge_iter_3
      source: code_build
      sourceHandle: source
      target: code_embed_prep
      targetHandle: target
      type: custom
      zIndex: 1002
    - data:
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        sourceType: code
        targetType: http-request
      id: edge_iter_4
      source: code_embed_prep
      sourceHandle: source
      target: http_embed
      targetHandle: target
      type: custom
      zIndex: 1002
    - data:
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        sourceType: http-request
        targetType: code
      id: edge_iter_5
      source: http_embed
      sourceHandle: source
      target: code_embed_merge
      targetHandle: target
      type: custom
      zIndex: 1002
    - data:
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        sourceType: code
        targetType: http-request
      id: edge_iter_6
      source: code_embed_merge
      sourceHandle: source
      target: http_sheet
      targetHandle: target
      type: custom
      zIndex: 1002
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: iteration
        targetType: end
      id: edge_5
      source: iteration_1
      sourceHandle: source
      target: end_1
      targetHandle: target
      type: custom
      zIndex: 0
    nodes:
    - data:
        selected: false
        title: 開始
        type: start
        variables:
        - allowed_file_types:
          - document
          label: 文字起こしファイル（.txt / .md）
          required: true
          type: file
          variable: transcript_file
        - label: MTGタイトル
          max_length: 256
          options: []
          required: true
          type: text-input
          variable: mtg_title
        - label: MTG日付（YYYY-MM-DD）
          max_length: 10
          options: []
          required: true
          type: text-input
          variable: mtg_date
        - label: タグ体系JSON（任意）
          max_length: 4096
          options: []
          required: false
          type: paragraph
          variable: taxonomy_json
      height: 187
      id: start_1
      position:
        x: 0
        y: 76
      positionAbsolute:
        x: 0
        y: 76
      selected: false
      type: custom
      width: 242
    - data:
        code: "def main(mtg_title: str) -> dict:\n    title = mtg_title.lower()\n\
          \    rules = [\n        ([\"youtube\", \"yt\", \"動画\", \"サムネ\", \"チャンネル\"\
          ], \"YouTube運用\"),\n        ([\"ミサオ\", \"みさお\"], \"ミサオch\"),\n        ([\"\
          あおんぼ\", \"顧問\"], \"あおんぼ顧問\"),\n        ([\"バズ塾\", \"ショート\"], \"バズ塾\"),\n\
          \        ([\"定例\", \"全体\"], \"全体定例\"),\n    ]\n    for keywords, project\
          \ in rules:\n        for kw in keywords:\n            if kw.lower() in title:\n\
          \                return {\"project\": project}\n    return {\"project\"\
          : \"\"}\n"
        code_language: python3
        outputs:
          project:
            children: null
            type: string
        selected: false
        title: プロジェクト自動分類
        type: code
        variables:
        - value_selector:
          - start_1
          - mtg_title
          value_type: string
          variable: mtg_title
      height: 52
      id: code_classify
      position:
        x: 342
        y: 144
      positionAbsolute:
        x: 342
        y: 144
      type: custom
      width: 242
    - data:
        is_array_file: false
        selected: false
        title: ドキュメント抽出
        type: document-extractor
        variable_selector:
        - start_1
        - transcript_file
      height: 104
      id: doc_extractor
      position:
        x: 684
        y: 144
      positionAbsolute:
        x: 684
        y: 144
      type: custom
      width: 242
    - data:
        code: "import re\nimport json\n\ndef main(transcript_text: str) -> dict:\n\
          \    \"\"\"\n    Loom/Zoom文字起こしフォーマットをパース\n    入力形式: \"HH:MM 話者名: テキスト\"\
          \ or \"H:MM:SS 話者名: テキスト\"\n    \"\"\"\n    lines = transcript_text.strip().split(\"\
          \\n\")\n    parsed_lines = []\n    speakers_set = set()\n\n    # フィラー除去パターン\n\
          \    filler_pattern = re.compile(\n        r'\\b(u+h+|u+m+|e+h+m*|h+m+|a+h+|m+h*m*|mhm|mm-hmm|mmhmm|'\n\
          \        r'heh|haha+|hihi+|aye|ooh|nah)\\b[,.\\s]*',\n        re.IGNORECASE\n\
          \    )\n    # 繰り返しフレーズ除去（例：\"hi hi hi hi...\"）\n    repeat_pattern = re.compile(r'\\\
          b(\\w+)\\s+(\\1\\s+){2,}', re.IGNORECASE)\n\n    for line in lines:\n  \
          \      line = line.strip()\n        if not line:\n            continue\n\
          \n        # \"HH:MM 話者名: テキスト\" or \"H:MM:SS 話者名: テキスト\" をパース\n        match\
          \ = re.match(r'^(\\d{1,2}:\\d{2}(?::\\d{2})?)\\s+([^:]+):\\s*(.+)$', line)\n\
          \        if match:\n            timestamp = match.group(1)\n           \
          \ speaker = match.group(2).strip()\n            text = match.group(3).strip()\n\
          \n            # フィラー除去\n            cleaned = filler_pattern.sub(' ', text)\n\
          \            # 繰り返し除去\n            cleaned = repeat_pattern.sub(r'\\1 ',\
          \ cleaned)\n            # 連続スペース正規化\n            cleaned = re.sub(r'\\s+',\
          \ ' ', cleaned).strip()\n            # 句読点のみ・短すぎる行はスキップ\n            content_only\
          \ = re.sub(r'[^a-zA-Z\\u3040-\\u309F\\u30A0-\\u30FF\\u4E00-\\u9FFF]', '',\
          \ cleaned)\n            if not content_only or len(content_only) < 2:\n\
          \                continue\n\n            speakers_set.add(speaker)\n   \
          \         parsed_lines.append(f\"[{timestamp}] {speaker}: {cleaned}\")\n\
          \n    cleaned_transcript = \"\\n\".join(parsed_lines)\n    speakers = sorted(list(speakers_set))\n\
          \n    return {\n        \"cleaned_transcript\": cleaned_transcript,\n  \
          \      \"speakers\": json.dumps(speakers, ensure_ascii=False),\n       \
          \ \"line_count\": len(parsed_lines),\n        \"original_line_count\": len(lines)\n\
          \    }\n"
        code_language: python3
        outputs:
          cleaned_transcript:
            children: null
            type: string
          line_count:
            children: null
            type: number
          original_line_count:
            children: null
            type: number
          speakers:
            children: null
            type: string
        selected: false
        title: テキストパース＋ノイズ除去
        type: code
        variables:
        - value_selector:
          - doc_extractor
          - text
          value_type: string
          variable: transcript_text
      height: 52
      id: code_parse
      position:
        x: 1026
        y: 144
      positionAbsolute:
        x: 1026
        y: 144
      type: custom
      width: 242
    - data:
        context:
          enabled: false
          variable_selector: []
        model:
          completion_params:
            temperature: 0.3
          mode: chat
          name: gpt-4o
          provider: langgenius/openai/openai
        prompt_template:
        - edition_type: basic
          id: prompt-chunk-system
          role: system
          text: 'あなたはMTGの文字起こしテキストを分析し、話題単位でチャンク分割する専門家です。


            ## タスク

            文字起こしテキストを話題の区切りで分割し、各チャンクにトピック名を付けてください。


            ## 話者情報

            このMTGの参加者: {{#code_parse.speakers#}}


            ## ルール

            - 1つのチャンクは1つの話題に対応させてください

            - チャンクが細かいほど、後のQA生成の精度が上がります

            - 雑談・意味のないやり取りだけのチャンクは省略してください

            - 各チャンクのcontentには話者名付きの発言をそのまま含めてください

            - タイムスタンプ情報も保持してください

            - 文字起こしの品質が低い部分（意味が通じない箇所）は除外してOKです

            - 有意義な内容が全くない場合は空配列を返してください


            ## 出力形式

            必ず以下のJSON形式のみで回答してください。説明文やマークダウンは不要です。

            {"chunks": [{"topic": "チャンクの話題名", "content": "話者名付きの会話内容", "speakers":
            ["話者A", "話者B"], "time_range": "03:00-07:30"}], "summary": "MTG全体の概要（1〜2文）"}

            '
        - id: prompt-chunk-user
          role: user
          text: '以下のMTG文字起こしテキストを話題チャンクに分割してください。


            MTGタイトル: {{#start_1.mtg_title#}}

            日付: {{#start_1.mtg_date#}}


            ---文字起こし（ノイズ除去済み、{{#code_parse.line_count#}}行 / 元{{#code_parse.original_line_count#}}行）---

            {{#code_parse.cleaned_transcript#}}

            '
        selected: false
        structured_output_enabled: false
        title: 話題チャンク分割
        type: llm
        vision:
          enabled: false
      height: 88
      id: llm_chunk
      position:
        x: 1368
        y: 126
      positionAbsolute:
        x: 1368
        y: 126
      type: custom
      width: 242
    - data:
        code: "import json\nimport re\n\ndef main(llm_text: str) -> dict:\n    try:\n\
          \        text = llm_text.strip()\n        # ```json ... ``` ブロックを除去\n  \
          \      match = re.search(r'```(?:json)?\\s*(.+?)\\s*```', text, re.DOTALL)\n\
          \        if match:\n            text = match.group(1)\n        data = json.loads(text)\n\
          \        chunks = data.get(\"chunks\", [])\n        summary = data.get(\"\
          summary\", \"\")\n        chunk_strings = []\n        for c in chunks:\n\
          \            c[\"mtg_summary\"] = summary\n            chunk_strings.append(json.dumps(c,\
          \ ensure_ascii=False))\n        return {\"chunks\": chunk_strings, \"count\"\
          : len(chunk_strings)}\n    except Exception as e:\n        return {\"chunks\"\
          : [], \"count\": 0}\n"
        code_language: python3
        outputs:
          chunks:
            children: null
            type: array[string]
          count:
            children: null
            type: number
        selected: false
        title: チャンク配列抽出
        type: code
        variables:
        - value_selector:
          - llm_chunk
          - text
          value_type: string
          variable: llm_text
      height: 52
      id: code_chunks
      position:
        x: 1710
        y: 144
      positionAbsolute:
        x: 1710
        y: 144
      type: custom
      width: 242
    - data:
        error_handle_mode: terminated
        flatten_output: true
        height: 340
        is_parallel: false
        iterator_input_type: array[string]
        iterator_selector:
        - code_chunks
        - chunks
        output_selector:
        - http_sheet
        - body
        output_type: array[string]
        parallel_nums: 10
        selected: false
        start_node_id: iteration_1_start
        title: チャンクごとQA生成
        type: iteration
        width: 2200
      height: 340
      id: iteration_1
      position:
        x: 2052
        y: 0
      positionAbsolute:
        x: 2052
        y: 0
      type: custom
      width: 2200
      zIndex: 1
    - data:
        isInIteration: true
        selected: false
        title: ''
        type: iteration-start
      draggable: false
      height: 48
      id: iteration_1_start
      parentId: iteration_1
      position:
        x: 60
        y: 105
      positionAbsolute:
        x: 2112
        y: 105
      selectable: false
      type: custom-iteration-start
      width: 44
      zIndex: 1002
    - data:
        context:
          enabled: false
          variable_selector: []
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        model:
          completion_params:
            temperature: 0.4
          mode: chat
          name: gpt-4o
          provider: langgenius/openai/openai
        prompt_template:
        - edition_type: basic
          id: prompt-qa-system
          role: system
          text: 'あなたはMTGの会話チャンクからQ&Aナレッジを生成する専門家です。


            ## タスク

            与えられた会話チャンクから、検索可能なQ&Aペアを生成してください。


            ## 固定タグ（YouTube運用カテゴリ）

            以下から該当するものを選択してください（複数可）：

            - 企画

            - 撮影

            - 編集

            - サムネ

            - タイトル

            - 分析

            - 運用全般


            ## 自由タグ

            会話内容から適切なキーワードタグを自動生成してください（例：CTR改善、冒頭離脱、コメント誘導など）


            ## ルール

            - 1チャンクから複数のQAを生成してください（粒度は細かいほど良い）

            - Questionは「〜とは？」「〜はどうすればいい？」など検索されやすい形にしてください

            - Answerは具体的で、会話の文脈がなくても理解できる形にしてください

            - 話者情報も保持してください（誰が言った知見か分かるように）

            - 文字起こしの品質が低く意味が不明確な部分からは無理にQAを作らないでください

            - QAが1つも作れない場合は空配列を返してください


            ## 出力形式

            必ず以下のJSON形式のみで回答してください。説明文やマークダウンは不要です。

            {"qa_pairs": [{"question": "質問文", "answer": "回答文", "fixed_tags": ["タグ1"],
            "free_tags": ["キーワード1"], "speaker": "話者名"}]}

            '
        - id: prompt-qa-user
          role: user
          text: '以下の会話チャンクからQ&Aナレッジを生成してください。


            {{#iteration_1.item#}}

            '
        selected: false
        structured_output_enabled: false
        title: QA生成＋タグ付け
        type: llm
        vision:
          enabled: false
      height: 88
      id: llm_qa
      parentId: iteration_1
      position:
        x: 184
        y: 85
      positionAbsolute:
        x: 2236
        y: 85
      type: custom
      width: 242
      zIndex: 1002
    - data:
        code: "import json\nimport re\nimport uuid\nfrom datetime import datetime\n\
          \ndef main(llm_text: str, mtg_title: str, mtg_date: str, chunk_item: str,\
          \ project: str) -> dict:\n    try:\n        text = llm_text.strip()\n  \
          \      match = re.search(r'```(?:json)?\\s*(.+?)\\s*```', text, re.DOTALL)\n\
          \        if match:\n            text = match.group(1)\n        qa_data =\
          \ json.loads(text)\n        qa_pairs = qa_data.get(\"qa_pairs\", [])\n\n\
          \        if isinstance(chunk_item, str):\n            chunk_data = json.loads(chunk_item)\n\
          \        else:\n            chunk_data = chunk_item\n        topic = chunk_data.get(\"\
          topic\", \"\")\n        time_range = chunk_data.get(\"time_range\", \"\"\
          )\n\n        rows = []\n        now = datetime.now().strftime(\"%Y-%m-%d\
          \ %H:%M:%S\")\n        for qa in qa_pairs:\n            rows.append({\n\
          \                \"id\": str(uuid.uuid4()),\n                \"mtg_title\"\
          : mtg_title,\n                \"mtg_date\": mtg_date,\n                \"\
          topic\": topic,\n                \"time_range\": time_range,\n         \
          \       \"question\": qa.get(\"question\", \"\"),\n                \"answer\"\
          : qa.get(\"answer\", \"\"),\n                \"fixed_tags\": \",\".join(qa.get(\"\
          fixed_tags\", [])),\n                \"free_tags\": \",\".join(qa.get(\"\
          free_tags\", [])),\n                \"speaker\": qa.get(\"speaker\", \"\"\
          ),\n                \"project\": project,\n                \"created_at\"\
          : now,\n                \"status\": \"active\"\n            })\n       \
          \ return {\"body_json\": json.dumps(rows, ensure_ascii=False)}\n    except\
          \ Exception as e:\n        return {\"body_json\": json.dumps([], ensure_ascii=False)}\n"
        code_language: python3
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        outputs:
          body_json:
            children: null
            type: string
        selected: false
        title: Supabase書き込みJSON構築
        type: code
        variables:
        - value_selector:
          - llm_qa
          - text
          value_type: string
          variable: llm_text
        - value_selector:
          - start_1
          - mtg_title
          value_type: string
          variable: mtg_title
        - value_selector:
          - start_1
          - mtg_date
          value_type: string
          variable: mtg_date
        - value_selector:
          - iteration_1
          - item
          value_type: string
          variable: chunk_item
        - value_selector:
          - code_classify
          - project
          value_type: string
          variable: project
      height: 52
      id: code_build
      parentId: iteration_1
      position:
        x: 506
        y: 103
      positionAbsolute:
        x: 2558
        y: 103
      type: custom
      width: 242
      zIndex: 1002
    - data:
        authorization:
          config: null
          type: no-auth
        body:
          data:
          - id: key-value-1
            key: ''
            type: text
            value: '{{#code_embed_merge.body_json#}}'
          type: json
        headers: 'apikey:{{#env.SUPABASE_KEY#}}

          Authorization:Bearer {{#env.SUPABASE_KEY#}}

          Content-Type:application/json

          Prefer:return=minimal'
        isInIteration: true
        isInLoop: false
        iteration_id: iteration_1
        method: post
        params: ''
        retry_config:
          max_retries: 3
          retry_enabled: true
          retry_interval: 500
        selected: false
        ssl_verify: true
        timeout:
          max_connect_timeout: 0
          max_read_timeout: 0
          max_write_timeout: 0
        title: Supabase QA書き込み
        type: http-request
