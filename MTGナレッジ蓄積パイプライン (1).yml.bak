          answer\", \"\")\n            texts.append(f\"{q} {a}\")\n        return\
          \ {\n            \"embed_input\": json.dumps(texts, ensure_ascii=False),\n\
          \            \"row_count\": len(rows),\n            \"body_json\": body_json\n\
          \        }\n    except Exception as e:\n        return {\"embed_input\"\
          : \"[]\", \"row_count\": 0, \"body_json\": body_json}\n"
