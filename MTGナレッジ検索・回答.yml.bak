app:
  description: ユーザーの質問からタグを抽出し、スプレッドシートのQAナレッジを検索して回答を生成するワークフロー
  icon: 🔍
  icon_background: '#E8F5E9'
  icon_type: emoji
  mode: workflow
  name: MTGナレッジ検索・回答
  use_icon_as_answer_icon: false
dependencies:
- current_identifier: null
  type: marketplace
  value:
    marketplace_plugin_unique_identifier: langgenius/openai:0.2.7@9031bbf9b37d9f6341a20c78a8bd18d686afd3ff627545496c3557705419d084
    version: null
kind: app
version: 0.6.0
workflow:
  conversation_variables: []
  environment_variables:
  - description: GAS WebアプリURL（スプシ検索用）
    id: env-gas-url
    name: GAS_WEBAPP_URL
    selector:
    - env
    - GAS_WEBAPP_URL
    value: ''
    value_type: string
  features:
    file_upload:
      allowed_file_extensions:
      - .JPG
      - .JPEG
      - .PNG
      - .GIF
      - .WEBP
      - .SVG
      allowed_file_types:
      - image
      allowed_file_upload_methods:
      - local_file
      - remote_url
      enabled: false
      fileUploadConfig:
        attachment_image_file_size_limit: 2
        audio_file_size_limit: 50
        batch_count_limit: 5
        file_size_limit: 15
        file_upload_limit: 50
        image_file_batch_limit: 10
        image_file_size_limit: 10
        single_chunk_attachment_limit: 10
        video_file_size_limit: 100
        workflow_file_upload_limit: 10
      image:
        enabled: false
        number_limits: 3
        transfer_methods:
        - local_file
        - remote_url
      number_limits: 3
    opening_statement: ''
    retriever_resource:
      enabled: false
    sensitive_word_avoidance:
      enabled: false
    speech_to_text:
      enabled: false
    suggested_questions: []
    suggested_questions_after_answer:
      enabled: false
    text_to_speech:
      enabled: false
      language: ''
      voice: ''
  graph:
    edges:
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: start
        targetType: llm
      id: edge_1
      source: start_1
      sourceHandle: source
      target: llm_analyze
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: llm
        targetType: code
      id: edge_2
      source: llm_analyze
      sourceHandle: source
      target: code_query
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: code
        targetType: http-request
      id: edge_3
      source: code_query
      sourceHandle: source
      target: http_search
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: http-request
        targetType: code
      id: edge_4
      source: http_search
      sourceHandle: source
      target: code_format
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: code
        targetType: if-else
      id: edge_5
      source: code_format
      sourceHandle: source
      target: if_else_1
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: if-else
        targetType: llm
      id: edge_6
      source: if_else_1
      sourceHandle: 'true'
      target: llm_answer
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: if-else
        targetType: code
      id: edge_7
      source: if_else_1
      sourceHandle: 'false'
      target: code_empty
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: llm
        targetType: variable-aggregator
      id: edge_8
      source: llm_answer
      sourceHandle: source
      target: aggregator_1
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: code
        targetType: variable-aggregator
      id: edge_9
      source: code_empty
      sourceHandle: source
      target: aggregator_1
      targetHandle: target
      type: custom
      zIndex: 0
    - data:
        isInIteration: false
        isInLoop: false
        sourceType: variable-aggregator
        targetType: end
      id: edge_10
      source: aggregator_1
      sourceHandle: source
      target: end_1
      targetHandle: target
      type: custom
      zIndex: 0
    nodes:
    - data:
        title: 開始
        type: start
        variables:
        - label: 質問を入力してください
          max_length: 2000
          options: []
          required: true
          type: paragraph
          variable: user_question
      height: 109
      id: start_1
      position:
        x: 0
        y: 0
      positionAbsolute:
        x: 0
        y: 0
      type: custom
      width: 242
    - data:
        context:
          enabled: false
          variable_selector: []
        model:
          completion_params:
            temperature: 0.2
          mode: chat
          name: gpt-4o-mini
          provider: langgenius/openai/openai
        prompt_template:
        - edition_type: basic
          id: prompt-analyze-system
          role: system
          text: 'あなたはユーザーの質問を分析し、検索用のタグとキーワードを抽出する専門家です。


            ## 固定タグ候補（YouTube運用カテゴリ）

            - 企画

            - 撮影

            - 編集

            - サムネ

            - タイトル

            - 分析

            - 運用全般


            ## タスク

            1. ユーザーの質問から、関連する固定タグを選択してください

            2. 質問から自由タグ（検索キーワード）を抽出してください

            3. 質問の意図を簡潔に要約してください


            ## ルール

            - 固定タグは該当するものを全て選択（該当なしなら空配列）

            - 自由タグは質問に含まれるキーワードや関連語を抽出

            - 検索精度を上げるため、同義語や関連語も含めてください

            '
        - id: prompt-analyze-user
          role: user
          text: '{{#start_1.user_question#}}'
        structured_output:
          schema:
            additionalProperties: false
            properties:
              fixed_tags:
                description: 該当する固定タグ
                items:
                  type: string
                type: array
              free_tags:
                description: 検索用キーワード・自由タグ
                items:
                  type: string
                type: array
              intent_summary:
                description: 質問意図の要約
                type: string
            required:
            - fixed_tags
            - free_tags
            - intent_summary
            type: object
        structured_output_enabled: true
        title: 質問分析＋タグ抽出
        type: llm
        vision:
          enabled: false
      height: 88
      id: llm_analyze
      position:
        x: 300
        y: 0
      positionAbsolute:
        x: 300
        y: 0
      type: custom
      width: 242
    - data:
        code: "import json\n\ndef main(structured_output: str) -> dict:\n    try:\n\
          \        if isinstance(structured_output, str):\n            data = json.loads(structured_output)\n\
          \        else:\n            data = structured_output\n        fixed_tags\
          \ = data.get(\"fixed_tags\", [])\n        free_tags = data.get(\"free_tags\"\
          , [])\n        intent = data.get(\"intent_summary\", \"\")\n        # GAS\
          \ Web Appに渡す検索パラメータ\n        query_params = {\n            \"action\": \"\
          search\",\n            \"fixed_tags\": \",\".join(fixed_tags),\n       \
          \     \"free_tags\": \",\".join(free_tags),\n            \"keyword\": intent\n\
          \        }\n        return {\n            \"query_string\": \"&\".join(f\"\
          {k}={v}\" for k, v in query_params.items()),\n            \"fixed_tags_str\"\
          : \",\".join(fixed_tags),\n            \"free_tags_str\": \",\".join(free_tags),\n\
          \            \"intent\": intent\n        }\n    except Exception as e:\n\
          \        return {\n            \"query_string\": \"action=search&keyword=\"\
          ,\n            \"fixed_tags_str\": \"\",\n            \"free_tags_str\"\
          : \"\",\n            \"intent\": \"\"\n        }\n"
        code_language: python3
        outputs:
          fixed_tags_str:
            children: null
            type: string
          free_tags_str:
            children: null
            type: string
          intent:
            children: null
            type: string
          query_string:
            children: null
            type: string
        title: 検索クエリ構築
        type: code
        variables:
        - value_selector:
          - llm_analyze
          - structured_output
          value_type: object
          variable: structured_output
      height: 52
      id: code_query
      position:
        x: 600
        y: 0
      positionAbsolute:
        x: 600
        y: 0
      type: custom
      width: 242
    - data:
        authorization:
          config: null
          type: no-auth
        body:
          data: []
          type: none
        headers: ''
        method: get
        params: '{{#code_query.query_string#}}'
        retry_config:
          max_retries: 3
          retry_enabled: true
          retry_interval: 500
        ssl_verify: true
        timeout:
          max_connect_timeout: 0
          max_read_timeout: 0
          max_write_timeout: 0
        title: スプシQA検索
        type: http-request
        url: '{{#env.GAS_WEBAPP_URL#}}'
        variables: []
      height: 125
      id: http_search
      position:
        x: 900
        y: 0
      positionAbsolute:
        x: 900
        y: 0
      type: custom
      width: 242
    - data:
        code: "import json\n\ndef main(response_body: str) -> dict:\n    try:\n  \
          \      data = json.loads(response_body)\n        results = data.get(\"results\"\
          , [])\n        if not results:\n            return {\"context\": \"\", \"\
          has_results\": False, \"count\": 0}\n\n        # QAをコンテキスト文字列に整形\n     \
          \   context_parts = []\n        for i, qa in enumerate(results, 1):\n  \
          \          part = f\"--- QA #{i} ---\\n\"\n            part += f\"Q: {qa.get('question',\
          \ '')}\\n\"\n            part += f\"A: {qa.get('answer', '')}\\n\"\n   \
          \         part += f\"タグ: {qa.get('fixed_tags', '')} / {qa.get('free_tags',\
          \ '')}\\n\"\n            part += f\"MTG: {qa.get('mtg_title', '')} ({qa.get('mtg_date',\
          \ '')})\\n\"\n            part += f\"話者: {qa.get('speaker', '')}\\n\"\n\
          \            context_parts.append(part)\n\n        return {\n          \
          \  \"context\": \"\\n\".join(context_parts),\n            \"has_results\"\
          : True,\n            \"count\": len(results)\n        }\n    except Exception\
          \ as e:\n        return {\"context\": \"\", \"has_results\": False, \"count\"\
          : 0}\n"
        code_language: python3
        outputs:
          context:
            children: null
            type: string
          count:
            children: null
            type: number
          has_results:
            children: null
            type: boolean
        title: 検索結果整形
        type: code
        variables:
        - value_selector:
          - http_search
          - body
          value_type: string
          variable: response_body
      height: 52
      id: code_format
      position:
        x: 1200
        y: 0
      positionAbsolute:
        x: 1200
        y: 0
      type: custom
      width: 242
    - data:
        cases:
        - case_id: 'true'
          conditions:
          - comparison_operator: is
            id: cond-has-results
            value: true
            varType: boolean
            variable_selector:
            - code_format
            - has_results
          id: 'true'
          logical_operator: and
        title: 結果有無チェック
        type: if-else
      height: 148
      id: if_else_1
      position:
        x: 1500
        y: 0
      positionAbsolute:
        x: 1500
        y: 0
      type: custom
      width: 242
    - data:
        context:
          enabled: false
          variable_selector: []
        model:
          completion_params:
            temperature: 0.5
          mode: chat
          name: gpt-4o
          provider: langgenius/openai/openai
        prompt_template:
        - edition_type: basic
          id: prompt-answer-system
          role: system
          text: 'あなたはYouTube運用チームのナレッジアシスタントです。

            過去のMTGで蓄積されたQ&Aナレッジをもとに、ユーザーの質問に回答してください。


            ## ルール

            - 提供されたQAナレッジに基づいて回答してください

            - ナレッジにない情報は推測せず、「この点についてはMTGで議論された記録がありません」と伝えてください

            - 複数のQAが関連する場合は、統合して一貫性のある回答にしてください

            - 矛盾するQAがある場合は、より新しい日付のものを優先し、両方の見解を提示してください

            - 情報源（どのMTGの内容か）を明記してください

            - 回答は具体的で実用的な内容にしてください

            '
        - id: prompt-answer-user
          role: user
          text: '## ユーザーの質問

            {{#start_1.user_question#}}


            ## 検索されたQAナレッジ（{{#code_format.count#}}件）

            {{#code_format.context#}}

            '
        structured_output_enabled: false
        title: 回答生成
        type: llm
        vision:
          enabled: false
      height: 88
      id: llm_answer
      position:
        x: 1800
        y: -100
      positionAbsolute:
        x: 1800
        y: -100
      type: custom
      width: 242
    - data:
        code: "def main() -> dict:\n    return {\"result\": \"申し訳ありませんが、お探しの情報に関連するMTGナレッジが見つかりませんでした。\\\
          n\\n質問の表現を変えて再度お試しいただくか、関連するキーワードを含めて質問してみてください。\"}\n"
        code_language: python3
        outputs:
          result:
            children: null
            type: string
        title: 結果なし応答
        type: code
        variables: []
      height: 52
      id: code_empty
      position:
        x: 1800
        y: 150
      positionAbsolute:
        x: 1800
        y: 150
      type: custom
      width: 242
    - data:
        output_type: string
        title: 回答集約
        type: variable-aggregator
        variables:
        - - llm_answer
          - text
        - - code_empty
          - result
      height: 135
      id: aggregator_1
      position:
        x: 2100
        y: 0
      positionAbsolute:
        x: 2100
        y: 0
      type: custom
      width: 242
    - data:
        outputs:
        - value_selector:
          - aggregator_1
          - output
          variable: answer
        - value_selector:
          - code_format
          - count
          variable: search_count
        title: 回答出力
        type: end
      height: 114
      id: end_1
      position:
        x: 2400
        y: 0
      positionAbsolute:
        x: 2400
        y: 0
      type: custom
      width: 242
    viewport:
      x: -1175
      y: 189
      zoom: 0.8
  rag_pipeline_variables: []
